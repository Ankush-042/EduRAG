# Database (SQLite by default for consumer-hardware feasibility; swap to a
# Postgres URL later without changing any model code)
DATABASE_URL=sqlite:///./data/edurag.db

# Vector store
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=edurag_chunks

# Models (all swappable via config, see app/core/interfaces.py)
ASR_MODEL=faster-whisper:base
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
NLI_MODEL=cross-encoder/nli-deberta-v3-base

# Device for the embedder/reranker/NLI models (PyTorch). Kept off the GPU
# by default -- running them on the same GPU faster-whisper's ctranslate2
# already has a CUDA context open on (in the same process) is a known
# cause of a silent process crash on Windows. Only set to "cuda" once
# you've confirmed your ctranslate2 + PyTorch CUDA builds coexist safely.
TORCH_MODEL_DEVICE=cpu

# Generation
# GENERATION_MODEL was llama-3.3-70b-versatile, which Groq decommissioned
# on 2026-08-16 -- openai/gpt-oss-120b is Groq's own recommended
# replacement for that production tier (console.groq.com/docs/deprecations).
GENERATION_PROVIDER=groq
GENERATION_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
LOCAL_GENERATION_MODEL=

# Retrieval tuning
MAX_RETRIEVAL_CANDIDATES=30
TOP_K_EVIDENCE=6

# Session
SESSION_TTL_HOURS=6

# YouTube download auth (optional — only needed if a specific video hits
# YouTube's "Sign in to confirm you're not a bot" bot-check). Set ONE:
#   YOUTUBE_COOKIES_FROM_BROWSER=chrome   (browser already logged into YouTube)
#   YOUTUBE_COOKIES_FILE=./cookies.txt    (exported via a browser extension)
YOUTUBE_COOKIES_FROM_BROWSER=
YOUTUBE_COOKIES_FILE=
